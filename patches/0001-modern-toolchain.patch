diff --git a/TGE/sbios/strcmp.c b/TGE/sbios/strcmp.c
new file mode 100644
index 0000000..e07bdc7
--- /dev/null
+++ b/TGE/sbios/strcmp.c
@@ -0,0 +1,23 @@
+/* strcmp for the TGE SBIOS.
+ *
+ * The SBIOS links -nostdlib and supplies its own string routines, one per file
+ * (strlen.S, strcpy.S, strncpy.S, memcpy.S, memset.S, memcmp.S) -- but never
+ * had a strcmp. smod.c/misc.c call it, and older toolchains satisfied that
+ * from libgcc or by inlining a builtin. gcc 15 does neither here, so the link
+ * fails with "undefined reference to `strcmp'".
+ *
+ * Plain C rather than hand-written MIPS: the neighbouring routines are
+ * quadword-optimised assembly from newlib, but strcmp is called only on short
+ * module-name strings during startup, so clarity beats speed and there is no
+ * assembly to get subtly wrong.
+ */
+
+int strcmp(const char *s1, const char *s2)
+{
+	while (*s1 && (*s1 == *s2)) {
+		s1++;
+		s2++;
+	}
+
+	return (int)(unsigned char)*s1 - (int)(unsigned char)*s2;
+}
diff --git a/config.mk b/config.mk
index f8ba16a..4343aef 100644
--- a/config.mk
+++ b/config.mk
@@ -15,6 +15,16 @@ RESET_IOP = yes
 # reset is done):
 LOAD_PS2LINK = no
 
+# Load the MX4SIO block device driver (SD card in a memory card slot).
+#
+# Default no. mx4sio_bd drives SIO2 directly rather than through sio2man, and
+# with no adapter fitted it does not return -- it hangs the module loading loop
+# and nothing after it is ever loaded, so the loader never reaches its menu.
+# That is what happens under PCSX2, which does not emulate the adapter at all.
+#
+# Set to yes only for a build destined for a console that has the adapter.
+MX4SIO = no
+
 # Use new ROM modules in loader.
 NEW_ROM_MODULES = no
 
