diff --git a/kernel/Makefile b/kernel/Makefile
index 5adc7ff..8456f9a 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -25,7 +25,14 @@ CFLAGS = -Wall -W -Werror-implicit-function-declaration -Wimplicit-int -EL -g \
 ifeq ($(NEW_KERNEL_TOOLCHAIN),yes)
 CFLAGS += -fno-builtin -mabi=n32 -march=r5900 -mno-llsc
 else
-CFLAGS += -mips3 -G0 -O0 -DPS2_EE
+# -mips3 replaced by -march=r5900. On gcc 15 the old flag forces -mgp64, which
+# collides with the target default -mno-odd-spreg ("unsupported combination").
+# -march=r5900 is also required for the assembler to accept the r5900 MMI
+# opcodes gcc emits (e.g. pextlw), which mips3 rejects.
+# -fno-builtin: gcc rewrites printf("...\n") into puts(), which does not exist
+# in this -nostdlib kernel ("undefined reference to `puts'"). The
+# NEW_KERNEL_TOOLCHAIN branch above already sets it for the same reason.
+CFLAGS += -march=r5900 -fno-builtin -G0 -O0 -DPS2_EE
 endif
 
 SRC = start $(PROGRAM) rtesif strlen strncpy \
