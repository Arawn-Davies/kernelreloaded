-		kprintf("padInit() failed.\n");
+	/* ps2sdk's libpad.h documents padInit() as "== 1 => OK". The original test
+	 * here was "!= 0", which treats the documented SUCCESS value as a failure:
+	 * padman loads and registers fine, then this returns early, padPortOpen()
+	 * is never reached and the loader comes up with no controller at all --
+	 * which also makes every "Press CROSS to continue" prompt undismissable.
+	 * Testing against the documented success value rather than against zero
+	 * keeps this correct whichever convention a given ps2sdk uses. */
+	ret = padInit(0);
+	if (ret != 1) {
+		kprintf("padInit() failed: %d\n", ret);
 		return;
 	}
 
