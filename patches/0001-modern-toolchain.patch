+static void
+HandleEMAC3Int(void)
+{
+	SMap*		pSMap=&SMap0;
+	u32		u32Status=EMAC3REG_READ(pSMap,SMAP_EMAC3_INTR_STAT);
+
+	//Clear EMAC3 interrupt.
+
+	EMAC3REG_WRITE(pSMap,SMAP_EMAC3_INTR_STAT,u32Status);
+}
