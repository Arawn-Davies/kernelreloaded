+
+static void
+RegInit(SMap* pSMap)
+{
+	SMap_DisableInterrupts(INTR_BITMSK);
+	ClearAllIRQs(pSMap);
+
+	//BD mode.
+
+	SMAP_REG8(pSMap,SMAP_BD_MODE)=0;	//Swap
+
+	//Reset TX/RX FIFO.
+
+	FIFOReset(pSMap);
+}
