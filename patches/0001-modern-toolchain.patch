diff --git a/TGE/sbios/strcmp.c b/TGE/sbios/strcmp.c
new file mode 100644
index 0000000..e07bdc7
--- /dev/null
+++ b/TGE/sbios/strcmp.c
@@ -0,0 +1,23 @@
+/* strcmp for the TGE SBIOS.
+ *
+ * The SBIOS links -nostdlib and supplies its own string routines, one per file
+ * (strlen.S, strcpy.S, strncpy.S, memcpy.S, memset.S, memcmp.S) -- but never
+ * had a strcmp. smod.c/misc.c call it, and older toolchains satisfied that
+ * from libgcc or by inlining a builtin. gcc 15 does neither here, so the link
+ * fails with "undefined reference to `strcmp'".
+ *
+ * Plain C rather than hand-written MIPS: the neighbouring routines are
+ * quadword-optimised assembly from newlib, but strcmp is called only on short
+ * module-name strings during startup, so clarity beats speed and there is no
+ * assembly to get subtly wrong.
+ */
+
+int strcmp(const char *s1, const char *s2)
+{
+	while (*s1 && (*s1 == *s2)) {
+		s1++;
+		s2++;
+	}
+
+	return (int)(unsigned char)*s1 - (int)(unsigned char)*s2;
+}
diff --git a/kernel/Makefile b/kernel/Makefile
index 5adc7ff..8456f9a 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -25,7 +25,14 @@ CFLAGS = -Wall -W -Werror-implicit-function-declaration -Wimplicit-int -EL -g \
 ifeq ($(NEW_KERNEL_TOOLCHAIN),yes)
 CFLAGS += -fno-builtin -mabi=n32 -march=r5900 -mno-llsc
 else
-CFLAGS += -mips3 -G0 -O0 -DPS2_EE
+# -mips3 replaced by -march=r5900. On gcc 15 the old flag forces -mgp64, which
+# collides with the target default -mno-odd-spreg ("unsupported combination").
+# -march=r5900 is also required for the assembler to accept the r5900 MMI
+# opcodes gcc emits (e.g. pextlw), which mips3 rejects.
+# -fno-builtin: gcc rewrites printf("...\n") into puts(), which does not exist
+# in this -nostdlib kernel ("undefined reference to `puts'"). The
+# NEW_KERNEL_TOOLCHAIN branch above already sets it for the same reason.
+CFLAGS += -march=r5900 -fno-builtin -G0 -O0 -DPS2_EE
 endif
 
 SRC = start $(PROGRAM) rtesif strlen strncpy \
