+	u32 mode;
+
+	if (modeList[modeIndex] == GS_AUTO_DETECT) {
+		mode = gsKit_detect_signal();
+	} else {
+		mode = modeList[modeIndex];
+	}
+
+	g->Mode = mode;
+
+	switch (mode) {
+	case GS_MODE_PAL:
+		g->Interlace = GS_INTERLACED;
+		g->Field = GS_FIELD;
+		g->Width = 640;
+		g->Height = 512;
+		break;
+	case GS_MODE_NTSC:
