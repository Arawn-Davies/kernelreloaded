diff --git a/TGE/Makefile b/TGE/Makefile
index 629037b..72469fb 100644
--- a/TGE/Makefile
+++ b/TGE/Makefile
@@ -1,7 +1,31 @@
+# intrelay restored. rickgaiser removed it in 4ba4d6e ("Remove irx modules no
+# longer needed", intrelay -> obsolete) alongside dmarelay, eedebug and smaprpc.
+# The last two moved to the linux-firmware-ps2 repo, but intrelay is still
+# REQUIRED by the 2.4.17-era kernels this loader targets -- upstream's own
+# readme says so: "Redirects interrupts from IOP to EE. Required: Yes." Without
+# it the loader gets as far as loading the kernel and then fails on
+# host:TGE/intrelay-direct.irx, which loader.c still references.
+#
+# Four variants, selected by the two switches, all installed into loader/TGE/:
+#   intrelay-direct.irx        no DEV9, no RPC  -- the normal one
+#   intrelay-direct-rpc.irx    slim PSTwo
+#   intrelay-dev9.irx          when ps2dev9/ps2link is used
+#   intrelay-dev9-rpc.irx      both
+#
+# dmarelay is deliberately NOT restored: upstream's readme states "dmarelay.irx
+# from TGE is not working".
 install:
+	make -C iop/intrelay DEV9_SUPPORT=no RPC_IRQ_SUPPORT=no install
+	make -C iop/intrelay DEV9_SUPPORT=no RPC_IRQ_SUPPORT=yes install
+	make -C iop/intrelay DEV9_SUPPORT=yes RPC_IRQ_SUPPORT=no install
+	make -C iop/intrelay DEV9_SUPPORT=yes RPC_IRQ_SUPPORT=yes install
 	make ROM_MODULE_VERSION=old -C sbios install
 	make ROM_MODULE_VERSION=new -C sbios install
 
 clean:
 	make ROM_MODULE_VERSION=old -C sbios clean
 	make ROM_MODULE_VERSION=new -C sbios clean
+	make -C iop/intrelay DEV9_SUPPORT=no RPC_IRQ_SUPPORT=no clean
+	make -C iop/intrelay DEV9_SUPPORT=no RPC_IRQ_SUPPORT=yes clean
+	make -C iop/intrelay DEV9_SUPPORT=yes RPC_IRQ_SUPPORT=no clean
+	make -C iop/intrelay DEV9_SUPPORT=yes RPC_IRQ_SUPPORT=yes clean
diff --git a/TGE/include/tge_types.h b/TGE/include/tge_types.h
index aebf339..9727ab1 100644
--- a/TGE/include/tge_types.h
+++ b/TGE/include/tge_types.h
@@ -11,15 +11,20 @@
 
 #include "stdint.h"
 
+/* u64/s64 were "unsigned/signed long int", which is only 64-bit when the
+ * compiler runs with -mgp64 (implied by the old -mips3 flag). Modern ps2dev gcc
+ * targets the n32 ABI where long is 32-bit, silently making u64 half-width --
+ * which shrank ee_dmatag_t from 16 to 12 bytes and broke the DMA tag layout.
+ * long long is 64-bit under both ABIs. Same defect as kernel/stdint.h. */
 typedef	unsigned char 		u8;
 typedef unsigned short 		u16;
 typedef unsigned int 		u32;
-typedef unsigned long int	u64;
+typedef unsigned long long	u64;
 
 typedef signed char 		s8;
 typedef signed short 		s16;
 typedef	signed int 		s32;
-typedef signed long int		s64;
+typedef signed long long	s64;
 
 #if defined(R5900) || defined(_R5900)
 typedef unsigned int		u128 __attribute__((mode(TI)));
diff --git a/TGE/iop/intrelay/Makefile b/TGE/iop/intrelay/Makefile
new file mode 100644
index 0000000..0699b03
--- /dev/null
+++ b/TGE/iop/intrelay/Makefile
@@ -0,0 +1,66 @@
+# _____     ___ ____     ___ ____
+#  ____|   |    ____|   |        | |____|
+# |     ___|   |____ ___|    ____| |    \    PS2DEV Open Source Project.
+#-----------------------------------------------------------------------
+# Copyright 2001-2004.
+# Licenced under Academic Free License version 2.0
+# Review ps2sdk README & LICENSE files for further details.
+
+IOP_BIN_DIR = bin/
+IOP_SRC_DIR = src/
+IOP_INC_DIR = include/
+
+DEV9_SUPPORT = no
+RPC_IRQ_SUPPORT = no
+ifeq ($(RPC_IRQ_SUPPORT),yes)
+IRQ_TYPE=-rpc
+IOP_CFLAGS += -DRPC_IRQ_SUPPORT
+else
+IRQ_TYPE=
+endif
+ifeq ($(DEV9_SUPPORT),yes)
+DEV9_TYPE=-dev9
+
+IOP_CFLAGS += -DDEV9_SUPPORT
+IOP_INCS += -I$(PS2SDKSRC)/iop/dev9/dev9/include
+else
+DEV9_TYPE=-direct
+endif
+IOP_OBJS_DIR = obj$(DEV9_TYPE)$(IRQ_TYPE)/
+IOP_BIN  = bin/intrelay$(DEV9_TYPE)$(IRQ_TYPE).irx
+
+IOP_MODS = intrelay imports usb
+# No addprefix: modern iop/Rules.make already applies IOP_OBJS_DIR itself
+# ("IOP_OBJS := $(IOP_OBJS:%=$(IOP_OBJS_DIR)%)"), so prefixing here too
+# produced obj-direct/obj-direct/intrelay.o and nothing would build.
+IOP_OBJS = $(addsuffix .o, $(IOP_MODS))
+IOP_INCS += -I../../include
+# -Werror dropped: gcc has grown a lot of diagnostics since 2004 and this is
+# 2004 code. Same decision as IOP_WARNFLAGS in the Dockerfile -- warnings
+# still print, they just no longer halt the build.
+IOP_CFLAGS  += -Wall -fno-builtin-printf -fno-builtin-memcpy -Wimplicit-int -Werror-implicit-function-declaration
+IOP_LDFLAGS += -s
+
+install: all
+	mkdir -p ../../../loader/TGE
+	install -m 644 -p $(IOP_BIN) ../../../loader/TGE
+
+# ps2sdk's iop/Rules.make used to supply rules that created these directories;
+# modern ps2sdk does not, so "all" failed with "No rule to make target
+# 'obj-direct/'". The four variants each need their own object directory
+# because they are compiled with different -D flags, so they cannot simply
+# build in place the way modules/SMSCDVD does.
+$(IOP_OBJS_DIR):
+	mkdir -p $@
+
+$(IOP_BIN_DIR):
+	mkdir -p $@
+
+all: $(IOP_OBJS_DIR) $(IOP_BIN_DIR) $(IOP_BIN)
+
+clean:
+	rm -f -r $(IOP_OBJS_DIR) $(IOP_BIN_DIR)
+
+include $(PS2SDKSRC)/Defs.make
+include $(PS2SDKSRC)/iop/Rules.make
+include $(PS2SDKSRC)/iop/Rules.release
