Make the ROM console tty bidirectional, and fix its write return.

romcons registers a tty driver for /dev/ttyS0 (TTY_MAJOR, minor 64) but wires
up only the transmit half.  SB_GETCHAR appears once, in the console's
wait_key(), which the tty layer never calls -- so nothing was ever pushed into
the flip buffer and every read() on the tty returned EOF.  Any shell started on
it read EOF, exited immediately and silently, and took the boot down with it.
There is no receive interrupt to hook, so poll the SIO RX FIFO from a timer.

The timer starts on first open rather than at registration: romtty_init() runs
from a __setup handler, long before sched_init() initialises the timer vectors,
and add_timer() that early corrupts them.

romtty_write separately returned its loop counter, which the loop had already
decremented to -1, so every write reported an error despite delivering all its
bytes.  Harmless until a program that checks write() ran on this tty.

--- a/arch/mips/ps2/romcons.c
+++ b/arch/mips/ps2/romcons.c
@@ -7,6 +7,7 @@
 #include <linux/tty_flip.h>
 #include <linux/major.h>
 #include <linux/console.h>
+#include <linux/timer.h>
 
 #include <asm/uaccess.h>
 #include <asm/ps2/sbcall.h>
@@ -17,13 +18,68 @@
 static struct termios *romtty_termios[1];
 static struct termios *romtty_termios_locked[1];
 
+/*
+ * The ROM console is bidirectional: SB_PUTCHAR drives the SIO TX FIFO and
+ * SB_GETCHAR drains the RX FIFO.  Only the transmit half was ever wired to
+ * the tty, so /dev/ttyS0 was write-only and every read() returned EOF.
+ * There is no receive interrupt to hook, so poll the FIFO from a timer and
+ * feed whatever turns up into the line discipline.
+ */
+#define ROMTTY_POLL	((HZ / 50) > 0 ? (HZ / 50) : 1)
+
+static struct tty_struct *romtty_tty;
+static struct timer_list romtty_poll_timer;
+static int romtty_polling;
+
+static void romtty_poll(unsigned long unused)
+{
+	struct tty_struct *tty = romtty_tty;
+	int c, n = 0;
+
+	/*
+	 * Bound the work per tick: a paste hands us a whole line at once and
+	 * this runs in timer context.
+	 */
+	while (tty != NULL && n < 64) {
+		if (tty->flip.count >= TTY_FLIPBUF_SIZE)
+			break;
+		c = sbios(SB_GETCHAR, NULL);
+		if (c == 0)
+			break;
+		tty_insert_flip_char(tty, c & 0xff, TTY_NORMAL);
+		n++;
+	}
+	if (n > 0)
+		tty_flip_buffer_push(tty);
+
+	mod_timer(&romtty_poll_timer, jiffies + ROMTTY_POLL);
+}
+
 static int romtty_open(struct tty_struct *tty, struct file *filp)
 {
+	romtty_tty = tty;
+
+	/*
+	 * Start polling here rather than at registration time: romtty_init()
+	 * runs from a __setup handler, long before sched_init() initialises
+	 * the timer vectors, and add_timer() that early corrupts them.
+	 */
+	if (!romtty_polling) {
+		romtty_polling = 1;
+		init_timer(&romtty_poll_timer);
+		romtty_poll_timer.function = romtty_poll;
+		romtty_poll_timer.data = 0;
+		romtty_poll_timer.expires = jiffies + ROMTTY_POLL;
+		add_timer(&romtty_poll_timer);
+	}
+
 	return 0;
 }
 
 static void romtty_close(struct tty_struct *tty, struct file *filp)
 {
+	if (romtty_tty == tty)
+		romtty_tty = NULL;
 }
 
 static int romtty_write(struct tty_struct *tty, int from_user,
@@ -31,10 +87,11 @@
 {
 	unsigned char ch;
 	struct sb_putchar_arg arg;
+	int written = 0;
 
 	if (!tty)
 		return 0;
-	while (count-- > 0) {
+	while (written < count) {
 		if (from_user)
 			copy_from_user(&ch, buf, 1);
 		else
@@ -42,9 +99,16 @@
 		buf++;
 		arg.c = ch;
 		sbios(SB_PUTCHAR, &arg);
+		written++;
 	}
 
-	return count;
+	/*
+	 * Return the count, not the loop variable.  The original decremented
+	 * count to -1 and returned that, so every write reported an error
+	 * even though all the bytes went out -- invisible until a program
+	 * that checks write() (ls, say) ran on this tty.
+	 */
+	return written;
 }
 
 static int romtty_write_room(struct tty_struct *tty)
