#!/bin/sh
#
# bin2s — embed a binary file into a MIPS assembly source as a named symbol.
#
#   bin2s <input-binary> <output.S> <symbol>
#
# WHY THIS EXISTS
# Modern ps2sdk dropped bin2s; it ships bin2c instead, which emits a C array
# with a different interface. kernelloader calls bin2s in eight places
# (kernel/, RTE/, loader/) to embed IRX modules, ELFs and image data, so a
# drop-in replacement is far less invasive than porting every call site.
#
# SYMBOL NAMING MATTERS. loader/Makefile generates romdefinitions.h with
#     extern unsigned char <symbol>[];
#     extern int size_<symbol>;
# so the size symbol must be "size_<symbol>", NOT "<symbol>_size". Getting this
# wrong links cleanly right up to the final ELF and then fails with ~30
# "undefined reference to `size_*'" errors from rominitialize.h.
# "<symbol>_end" and "<symbol>_size" are emitted as well, purely so this stays
# a true drop-in for callers that expect the classic names; kernelloader itself
# consumes only <symbol> and size_<symbol>.
#
# The section directive must be a bare ".data", NOT ".section .data".
# loader/Makefile post-processes this output with
#     sed -e "s/\.data/.section .rom/g"
# to move embedded blobs into the .rom section, so ".section .data" would
# become ".section .section .rom" and the assembler rejects it with
# "junk at end of line". The original ps2sdk bin2s emitted a bare ".data".
#
# Kept in tools/ rather than inside the loader/ source tree so that tree stays
# a clean copy of upstream's layout.

set -eu

if [ $# -ne 3 ]; then
    echo "usage: $(basename "$0") <input-binary> <output.S> <symbol>" >&2
    exit 1
fi

input="$1"
output="$2"
symbol="$3"

[ -f "$input" ] || { echo "bin2s: no such file: $input" >&2; exit 1; }

# .incbin resolves relative to the assembler's working directory, which is the
# directory the Makefile invoked us from — the same place the original bin2s
# recorded. Use an absolute path so the result does not depend on that.
abs_input=$(cd "$(dirname "$input")" && pwd)/$(basename "$input")

cat > "$output" <<EOF
/* Generated by kernelreloaded tools/bin2s from $(basename "$input"). Do not edit. */
	.set	noreorder
	.set	nomacro
	.set	noat
	.data
	.align	4

	.globl	${symbol}
${symbol}:
	.incbin	"${abs_input}"

	.globl	${symbol}_end
${symbol}_end:

	.align	2
	.globl	size_${symbol}
size_${symbol}:
	.int	${symbol}_end - ${symbol}

	.globl	${symbol}_size
${symbol}_size:
	.int	${symbol}_end - ${symbol}
EOF
