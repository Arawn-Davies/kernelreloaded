# ---------------------------------------------------------------------------
# kernelloader build output.
#
# These were upstream's own .gitignore rules, merged in when the source tree
# was flattened to the repo root. Without them the build drops ~45 binaries and
# 17 generated headers into the tree and a plain `git add` commits the lot --
# which happened once already.
#
# Everything below is reproducible from source. Notably the four
# TGE/iop/intrelay outputs LOOK like vendored blobs, because ps2sdk does not
# ship them, but TGE/Makefile builds them from TGE/iop/intrelay/src.
#
# To prove nothing needed is ignored: git clean -Xdf . && ./build.sh
# ---------------------------------------------------------------------------
*.bin
*.erl
*.irx
*.rgb
*.swp
*.tmp

# Host tools, built for the build machine rather than the EE.
crc32gen/crc32gen
png2rgb/png2rgb
ppm2rgb/ppm2rgb

# Generated by the kernel Makefile.
kernel/demo.S

# ROM tables rom.c includes, generated by loader/Makefile.
loader/romdefinitions.h
loader/romfilelist.h
loader/rominitialize.h

# bin2s wraps each texture into a header; one per RGB_FILES entry.
loader/back.h
loader/barfill.h
loader/bartrack.h
loader/bottombar.h
loader/disc.h
loader/folder.h
loader/highlight.h
loader/panel.h
loader/penguin.h
loader/selected.h
loader/starfield.h
loader/title.h
loader/unselected.h
loader/up.h

# Textures build.sh copies in from assets/ at build time. assets/ is the single
# source of truth for artwork we author; tracking the copies too invites edits
# to one and not the other. The five textures still tracked in loader/
# (back, folder, selected, unselected, up) are upstream's originals, which have
# no assets/ counterpart.
loader/barfill.png
loader/bartrack.png
loader/bottombar.png
loader/disc.png
loader/highlight.png
loader/panel.png
loader/penguin.png
loader/starfield.png
loader/title.png

# Kernel and initrd dropped in for boot testing. These are BlackRhino release
# binaries, not ours to redistribute, and the pair in use changes per test.
# Matched case-insensitively because /mnt/c is, and VMLINUX.GZ has silently
# replaced vmlinux.gz here before.
[Vv][Mm][Ll][Ii][Nn][Uu][Xx]*.gz
[Ii][Nn][Ii][Tt][Rr][Dd]*.gz
